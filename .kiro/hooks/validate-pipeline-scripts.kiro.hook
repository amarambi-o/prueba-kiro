{
  "enabled": true,
  "name": "Validar scripts del pipeline",
  "description": "Al guardar cualquier script Python en app/, verifica sintaxis y posibles errores antes de ejecutar el pipeline",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "app/*.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "El archivo app Python fue editado. Usa getDiagnostics para verificar que no hay errores de sintaxis ni imports rotos. Si hay errores, descríbelos brevemente y sugiere la corrección. Si todo está bien, confirma con una línea."
  }
}